#!/usr/bin/env sh
# BudgieOSMaker: generate a minimal Multiboot2 x86 kernel starter.
set -eu

OUT=${1:-BudgieOS-OS}
if [ -e "$OUT/kernel/boot.S" ]; then
  echo "Refusing to overwrite an existing kernel project: $OUT" >&2
  exit 1
fi

mkdir -p "$OUT/kernel" "$OUT/boot/grub"

cat > "$OUT/kernel/boot.S" <<'ASM'
.section .multiboot2
.align 8
mb2_header:
    .long 0xe85250d6
    .long 0
    .long mb2_header_end - mb2_header
    .long -(0xe85250d6 + (mb2_header_end - mb2_header))
    .short 0
    .short 0
    .long 8
mb2_header_end:

.section .bss
.align 16
stack_bottom:
    .skip 16384
stack_top:

.section .text
.global _start
.type _start, @function
.extern kernel_main
_start:
    cli
    mov $stack_top, %esp
    call kernel_main
1:
    hlt
    jmp 1b
.size _start, . - _start
ASM

cat > "$OUT/kernel/kernel.c" <<'C'
#include <stdint.h>

extern void kernel_cpp_init(void);

static volatile uint16_t *const VGA = (uint16_t *)0xB8000;
static uint16_t cursor = 0;

static void write_text(const char *text, uint8_t color) {
    while (*text && cursor < 80 * 25) {
        if (*text == '\\n') {
            cursor = (uint16_t)(((cursor / 80) + 1) * 80);
        } else {
            VGA[cursor++] = (uint16_t)text[0] | ((uint16_t)color << 8);
        }
        ++text;
    }
}

void kernel_main(void) {
    for (uint16_t i = 0; i < 80 * 25; ++i) {
        VGA[i] = (uint16_t)' ' | ((uint16_t)0x07 << 8);
    }
    cursor = 0;
    write_text("BudgieOS kernel booted!", 0x0A);
    write_text("\\nASM + C + C++ kernel starter", 0x0F);
    kernel_cpp_init();
    for (;;) {
        __asm__ volatile ("hlt");
    }
}
C

cat > "$OUT/kernel/kernel.cpp" <<'CPP'
extern "C" void kernel_cpp_init(void) {
    // C++ kernel initialization hook.
    // Keep this freestanding: do not use the C++ standard library yet.
}
CPP

cat > "$OUT/linker.ld" <<'LD'
ENTRY(_start)
SECTIONS
{
    . = 1M;
    .multiboot2 : { KEEP(*(.multiboot2)) }
    .text : ALIGN(4K) { *(.text*) }
    .rodata : ALIGN(4K) { *(.rodata*) }
    .data : ALIGN(4K) { *(.data*) }
    .bss : ALIGN(4K) { *(COMMON) *(.bss*) }
}
LD

cat > "$OUT/boot/grub/grub.cfg" <<'GRUB'
set timeout=0
set default=0

menuentry "BudgieOS" {
    multiboot2 /boot/kernel.elf
    boot
}
GRUB

cat > "$OUT/Makefile" <<'MAKE'
CC := i686-elf-gcc
CXX := i686-elf-g++
ASFLAGS := -m32
CFLAGS := -std=gnu11 -m32 -ffreestanding -O2 -Wall -Wextra
CXXFLAGS := -std=c++17 -m32 -ffreestanding -O2 -Wall -Wextra \\
            -fno-exceptions -fno-rtti -fno-threadsafe-statics -fno-use-cxa-atexit
LDFLAGS := -m32 -T linker.ld -nostdlib
BUILD := build
OBJECTS := $(BUILD)/boot.o $(BUILD)/kernel.o $(BUILD)/kernel_cpp.o

.PHONY: all iso clean check-tools
all: $(BUILD)/kernel.elf

check-tools:
	@command -v $(CC) >/dev/null || (echo "Missing $(CC) cross-compiler"; exit 1)
	@command -v $(CXX) >/dev/null || (echo "Missing $(CXX) cross-compiler"; exit 1)

$(BUILD):
	mkdir -p $(BUILD)

$(BUILD)/boot.o: kernel/boot.S | $(BUILD)
	$(CC) $(ASFLAGS) -c $< -o $@

$(BUILD)/kernel.o: kernel/kernel.c | $(BUILD)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/kernel_cpp.o: kernel/kernel.cpp | $(BUILD)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(BUILD)/kernel.elf: $(OBJECTS)
	$(CC) $(LDFLAGS) -o $@ $(OBJECTS) -lgcc

iso: $(BUILD)/kernel.elf
	command -v grub-mkrescue >/dev/null || (echo "Install GRUB utilities and xorriso first"; exit 1)
	mkdir -p $(BUILD)/iso/boot/grub
	cp $(BUILD)/kernel.elf $(BUILD)/iso/boot/kernel.elf
	cp boot/grub/grub.cfg $(BUILD)/iso/boot/grub/grub.cfg
	grub-mkrescue -o $(BUILD)/BudgieOS.iso $(BUILD)/iso

clean:
	rm -rf $(BUILD)
MAKE

cat > "$OUT/README.md" <<'README'
# BudgieOS kernel starter

Generated by **BudgieOSMaker**. This is an experimental x86 (32-bit protected-mode) Multiboot2 kernel starter using:

- GNU assembler syntax in `kernel/boot.S`
- freestanding C in `kernel/kernel.c`
- freestanding C++ in `kernel/kernel.cpp`
- a linker script and GRUB boot menu

It is a learning scaffold, not a complete operating system. It currently writes a message to VGA text memory and halts.

## Build requirements

Use a Unix-like development environment (Linux, macOS with suitable toolchain, or WSL) with:
- `i686-elf-gcc` and `i686-elf-g++` cross-compilers
- GNU Make
- GRUB utilities and `xorriso` to create the ISO

## Build

```sh
make check-tools
make
make iso
```

The ISO is written to `build/BudgieOS.iso`. Test it in an emulator such as QEMU; do not write it to a physical disk as part of the starter workflow.

## Important

This starter targets 32-bit x86 Multiboot2, not x86_64. It does not include drivers, storage, networking, userspace, security boundaries, or an installer. C++ is freestanding: standard-library features, exceptions, RTTI, and global runtime initialization are not available yet.
README

echo "Created kernel project at: $OUT"
echo "Next: cd \"$OUT\" && make check-tools && make iso"
